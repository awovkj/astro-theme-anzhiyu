{
  "name": "astro-theme-anzhiyu",
  "version": "1.0.0",
  "description": "AnZhiYu theme refactored for Astro — Card UI design, styling preserved from the original Hexo theme.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "check:css": "node scripts/compile-css.cjs --check",
    "check:font": "node scripts/check-font-coverage.cjs",
    "validate": "npm run test && npm run check && npm run check:css && npm run build && npm run check:dist",
    "preview": "astro preview",
    "compile:css": "node scripts/compile-css.cjs",
    "subset:font": "node scripts/subset-font.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "keywords": [
    "astro",
    "theme",
    "anzhiyu",
    "Card UI Design",
    "blog"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "csso": "^5.0.5",
    "nib": "^1.2.0",
    "stylus": "^0.63.0",
    "typescript": "^5.9.3"
  },
  "license": "GPL-3.0"
}
