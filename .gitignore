# 构建产物
dist/
.astro/

# 依赖
node_modules/

# 日志
*.log
astro-dev.log
preview.log

# 临时文件
*.tmp
.subset-chars.txt
theme.csso.css

# 原始字体（子集化源文件，5.75MB，按需手动放置）
scripts/fonts/

# 环境变量
.env
.env.*

# 编辑器
.vscode/
.idea/

# 工具运行时产物（项目记忆、本地状态，不应入库）
.workbuddy/
.workbuddy-ai/
.data/
.chrome-debug/
.playwright-mcp/

# Cloudflare Workers
.wrangler/
.dev.vars
.dev.vars.*

# 托管平台 CLI 产物
.vercel/
.netlify/
.edgeone/

# EdgeOne 构建时自带的 Node 运行时（installCommand 下载解压）
.node-runtime/

# 系统隐藏文件
.DS_Store
Thumbs.db
