---
import { theme } from "../lib/theme";
import { _p } from "../lib/i18n";
import { url_for } from "../lib/helpers";

const t = theme as any;
const commentsCfg = t.comments || {};
const use = commentsCfg.use;
const useArr = (Array.isArray(use) ? use : use ? [use] : []).filter(Boolean);
const hasComments = useArr.length > 0;
const defaultComment = hasComments ? useArr[0] : "";
const lazyload = commentsCfg.lazyload || false;
const count = commentsCfg.count || false;
const visitorMailEnable = t.visitorMail?.enable || false;

const twikooCfg = t.twikoo || {};
const twikooEnvId = twikooCfg.envId || "";
const twikooRegion = twikooCfg.region || "";
const twikooOption = twikooCfg.option || {};
const twikooCdn = "https://cdn.cbd.int/twikoo@1.6.44/dist/twikoo.all.min.js";

const walineCfg = t.waline || {};
const walineServerURL = walineCfg.serverURL || "";
const walinePageview = walineCfg.pageview || false;
const walineImageUploader = walineCfg.imageUploader !== undefined ? walineCfg.imageUploader : true;
const walineOption = walineCfg.option || {};
const walineMetaCss = walineCfg.meta_css || false;
const walineJsCdn = "https://cdn.cbd.int/@waline/client@3.8.0/dist/waline.js";
const walineCssCdn = "https://cdn.cbd.int/@waline/client@3.8.0/dist/waline.css";
const walineMetaCssCdn = "https://cdn.cbd.int/@waline/client@3.8.0/dist/waline-meta.css";

const twikooReady = defaultComment === "Twikoo" && twikooEnvId;
const walineReady = defaultComment === "Waline" && walineServerURL;

const twikooInitScript = twikooReady
  ? `(function(){var init=function(){twikoo.init(Object.assign({el:'#twikoo-wrap',envId:${JSON.stringify(twikooEnvId)},region:${JSON.stringify(twikooRegion)},onCommentLoaded:function(){if(window.anzhiyu&&window.anzhiyu.loadLightbox){window.anzhiyu.loadLightbox(document.querySelectorAll('#twikoo .tk-content img:not(.tk-owo-emotion)'));}}},${JSON.stringify(twikooOption)}));};if(typeof twikoo==='object'){setTimeout(init,0);}else{var s=document.createElement('script');s.src=${JSON.stringify(twikooCdn)};s.onload=init;document.head.appendChild(s);}})();`
  : "";

const walineInitScript = walineReady
  ? `import{init}from${JSON.stringify(walineJsCdn)};init(Object.assign({el:'#waline-wrap',serverURL:${JSON.stringify(walineServerURL)},pageview:${lazyload ? false : walinePageview},dark:'html[data-theme="dark"]',path:window.location.pathname,comment:${lazyload ? false : count},imageUploader:${walineImageUploader}},${JSON.stringify(walineOption)}));`
  : "";
---
{hasComments && (
  <hr />
  <div id="post-comment">
    <div class="comment-head">
      <div class="comment-headline">
        <i class="anzhiyufont anzhiyu-icon-comments"></i>
        <span>{' ' + _p('comment')}</span>
      </div>
      <div class="comment-randomInfo">
        <a onclick="anzhiyu.addRandomCommentInfo()" href="javascript:void(0)" style={visitorMailEnable ? '' : 'display: none'}>匿名评论</a>
        <a href={url_for('/privacy')} style="margin-left: 4px">隐私政策</a>
      </div>
      {useArr.length > 1 && (
        <div class="comment-switch">
          <span class="first-comment">{defaultComment}</span>
          <span id="switch-btn"></span>
          <span class="second-comment">{useArr[1]}</span>
        </div>
      )}
      {defaultComment === 'Twikoo' && (
        <div class="comment-tips" id="comment-tips">
          <span>✅ 你无需删除空行，直接评论以获取最佳展示效果</span>
        </div>
      )}
    </div>
    <div class="comment-wrap">
      <div>
        {defaultComment === 'Twikoo' && <div id="twikoo-wrap"></div>}
        {defaultComment === 'Waline' && <div id="waline-wrap"></div>}
        {defaultComment === 'Valine' && <div id="vcomment" class="vcomment"></div>}
        {defaultComment === 'Artalk' && <div id="artalk-wrap"></div>}
        {defaultComment === 'Giscus' && <div id="giscus-wrap"></div>}
      </div>
    </div>
  </div>
)}
{twikooReady && <script is:inline set:html={twikooInitScript} />}
{walineReady && <link rel="stylesheet" href={walineCssCdn} />}
{walineReady && walineMetaCss && <link rel="stylesheet" href={walineMetaCssCdn} />}
{walineReady && <script is:inline type="module" set:html={walineInitScript} />}
