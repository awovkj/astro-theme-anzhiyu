---
import { theme } from "../lib/theme";
import { site } from "../lib/site";
import { _p } from "../lib/i18n";
import { globalConfig, globalConfigSite } from "../lib/globalConfig";
import { url_for } from "../lib/helpers";

interface Props {
  title: string;
  pageTitle?: string;
  keywords?: string;
  description?: string;
  isPost?: boolean;
  isHome?: boolean;
  showToc?: boolean;
  postUpdate?: string;
}
const {
  title,
  pageTitle = title,
  keywords,
  description = site.description,
  isPost = false,
  isHome = false,
  showToc = false,
  postUpdate = "",
} = Astro.props;

const t = theme as any;
const themeColorLight = (t.theme_color && t.theme_color.enable && t.theme_color.meta_theme_color_light) || "#ffffff";
const themeColorDark = (t.theme_color && t.theme_color.enable && t.theme_color.meta_theme_color_dark) || "#0d0d0d";
const themeColor = t.display_mode === "dark" ? themeColorDark : themeColorLight;

const pageKeywords = keywords || (Array.isArray((site as any).keywords) ? (site as any).keywords.join(",") : "");
const pageAuthor = site.email ? `${site.author},${site.email}` : site.author;
const pageCopyright = (site as any).copyright || site.author;

const GLOBAL_CONFIG = globalConfig();
const GLOBAL_CONFIG_SITE = globalConfigSite({ title: site.title, pageTitle, isPost, isHome, showToc, postUpdate });
// Use the current route instead of pointing every page's canonical/OG URL at
// the homepage. Astro.url already includes a configured deployment base path.
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;

// Icon font (anzhiyu iconfont) — self-hosted under /iconfont (same-origin,
// no third-party CDN on the render-blocking path).
const iconfontCss = url_for("/iconfont/ali_iconfont.css");
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
{keywords && <meta name="keywords" content={pageKeywords} />}
<meta name="author" content={pageAuthor} />
<meta name="copyright" content={pageCopyright} />
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content={themeColor} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-touch-fullscreen" content="yes" />
<meta name="apple-mobile-web-app-title" content={pageTitle} />
<meta name="application-name" content={pageTitle} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content={themeColor} />

<!-- Open Graph -->
<meta property="og:type" content={isPost ? "article" : "website"} />
<meta property="og:title" content={pageTitle} />
<meta property="og:url" content={canonicalUrl} />
{description && <meta property="og:description" content={description} />}
<meta property="og:site_name" content={site.title} />

<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href={url_for(site.favicon)} />

<link rel="preload" as="style" href={iconfontCss} />
<link rel="stylesheet" href={iconfontCss} />
{(t.icons && t.icons.fontawesome) && (
  <link rel="stylesheet" href={t.icons.fontawesome} />
)}

<script is:inline define:vars={{ GLOBAL_CONFIG }}>
  window.GLOBAL_CONFIG = GLOBAL_CONFIG;
</script>
<script is:inline define:vars={{ GLOBAL_CONFIG_SITE }}>
  window.GLOBAL_CONFIG_SITE = GLOBAL_CONFIG_SITE;
</script>
