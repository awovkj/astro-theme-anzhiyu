---
import { theme } from "../lib/theme";
import { site } from "../lib/site";
import { _p } from "../lib/i18n";
import { url_for, date, date_xml, fullDate } from "../lib/helpers";
import type { PostItem, TagInfo } from "../lib/collections";

interface Props {
  isPost?: boolean;
  showToc?: boolean;
  tocHtml?: string;
  posts?: PostItem[];
  tags?: TagInfo[];
}
const { showToc = false, tocHtml = "", posts = [], tags = [] } = Astro.props;
const t = theme as any;

const a = t.aside || {};
const recLimit = a.card_recent_post?.limit === 0 ? posts.length : a.card_recent_post?.limit || 5;
const recSort = a.card_recent_post?.sort === "updated" ? "updated" : "date";
const recent = [...posts].sort((x, y) => (recSort === "updated" ? +((y.updated as Date) || y.date) - +((x.updated as Date) || x.date) : +y.date - +x.date)).slice(0, recLimit);

// NotionNext 风格标签组（collections 已按文章数降序）
const tagLimit = a.card_tags?.limit === 0 ? tags.length : a.card_tags?.limit || 40;
const nnTags = tags.slice(0, tagLimit);

// 建站天数（构建时计算，与 NotionNext AnalyticsCard 渲染逻辑一致）
// 时间源与底部计时器统一：优先 footer.runtime.launch_time，runtimeshow.publish_date 作为兼容回退
const runtimeshow = t.runtimeshow || {};
let runtimeDays: number | null = null;
if (runtimeshow.enable) {
  const source = (t.footer?.runtime?.enable && t.footer?.runtime?.launch_time) || runtimeshow.publish_date;
  if (source) {
    const pd = new Date(String(source).replace(/-/g, "/"));
    if (!Number.isNaN(+pd)) runtimeDays = Math.max(0, Math.ceil((Date.now() - +pd) / 864e5));
  }
}

const avatar = (t.avatar && t.avatar.img) || site.avatar;
const social = t.social || {};
const authorDesc = (a.card_author && a.card_author.description) || site.description;
const authorStatus = t.author_status || {};
// 注：微信公众号卡片用的 `weixin` 变量已删除 —— 该卡片的标记在下方被整体注释
// （停用），留着就是死变量。重新启用时按下方注释补回即可。
---

<div id="aside-content" class="aside-content">
  {a.card_author?.enable && (
    <div class="card-widget card-info">
      <div class="card-content">
        {authorStatus.enable && <div class="author-info__sayhi" id="author-info__sayhi"></div>}
        <div class="author-info-avatar">
          <img class="avatar-img" src={url_for(avatar)} alt="avatar" />
          {authorStatus.enable && authorStatus.statusImg && <div class="author-status"><img src={url_for(authorStatus.statusImg)} class="g-status" alt="status" /></div>}
        </div>
        <div class="author-info__description" set:html={authorDesc} />
        {social && Object.keys(social).length > 0 && (
          <div class="author-info__bottom-group">
            <a class="author-info__bottom-group-left" href={url_for((a.card_author && a.card_author.name_link) || "/")}>
              <h1 class="author-info__name">{site.author}</h1>
              <div class="author-info__desc">{site.subtitle}</div>
            </a>
            <div class="card-info-social-icons is-center">
              {Object.entries(social).map(([title, value]) => {
                const v = String(value);
                const parts = v.split("||").map((s) => s.trim());
                const icon = parts[1];
                return <a class="social-icon faa-parent animated-hover" href={url_for(parts[0])} target="_blank" title={title}>{icon?.startsWith("anzhiyu") && <i class={`anzhiyufont ${icon}`}></i>}</a>;
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  {a.card_announcement?.enable && (
    <div class="card-widget card-announcement">
      <div class="item-headline"><i class="anzhiyufont anzhiyu-icon-bullhorn anzhiyu-shake"></i><span>{_p("aside.card_announcement")}</span></div>
      <div class="announcement_content" set:html={a.card_announcement.content} />
    </div>
  )}

  {/*
    微信公众号卡片 —— 当前停用。

    样式是完整的（theme.css 里的 #card-wechat / #flip-wrapper / #flip-content，
    翻转效果为纯 CSS：`#flip-wrapper:hover #flip-content { rotateY(180deg) }`，
    不依赖任何客户端脚本），所以这纯粹是「标记被注释掉」而非「功能缺失」。

    要重新启用，三处一起改：
      1. 取消下面 {weixin.enable && ( ... )} 的注释；
      2. 在文件顶部补回 `const weixin = a.card_weixin || {};`
         （当前已删除，因为标记注释掉后它是死变量，会触发 astro check 的未使用告警）；
      3. 把 _config.yml 的 aside.card_weixin.enable 置回 true。

  {weixin.enable && (
    <div class="card-widget anzhiyu-right-widget" id="card-wechat">
      <div id="flip-wrapper"><div id="flip-content">
        <div class="face" style={`background: url(${weixin.face}) center center / 100% no-repeat`}></div>
        <div class="back face" style={`background: url(${weixin.backFace}) center center / 100% no-repeat`}></div>
      </div></div>
    </div>
  )} */}

  <div class="sticky_layout">
    {showToc && (
      <div id="card-toc" class="card-widget">
        <div class="item-headline"><i class="anzhiyufont anzhiyu-icon-bars"></i><span>{_p("aside.card_toc")}</span><span class="toc-percentage"></span></div>
        <div class="toc-content" set:html={tocHtml} />
      </div>
    )}

    {a.card_recent_post?.enable && (
      <div class="card-widget nn-card">
        <div class="nn-card-header">
          <i class="anzhiyufont anzhiyu-icon-history"></i>
          <span>最新发布</span>
        </div>
        <div class="nn-latest-list">
          {recent.map((article) => {
            const link = article.path;
            const title = article.title;
            const cover = typeof article.cover === "string" ? article.cover : false;
            const showCover = !!cover && !!t.cover?.aside_enable;
            const time = recSort === "updated" ? article.updated || article.date : article.date;
            return (
              <a class={`nn-latest-item${showCover ? "" : " no-cover"}`} href={url_for(link)} title={title}>
                {showCover && (
                  <div class="nn-latest-cover">
                    <img src={url_for(String(cover))} alt={title} loading="lazy" />
                  </div>
                )}
                <div class="nn-latest-info">
                  <div class="nn-latest-title">{title}</div>
                  <time class="nn-latest-date" datetime={date_xml(time)} title={_p("post.created") + " " + fullDate(time)}>{date(time, (site as any).date_format || "YYYY-MM-DD")}</time>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    {(nnTags.length > 0 || a.card_webinfo?.post_count || runtimeDays !== null) && (
      <div class="card-widget nn-card">
        {nnTags.length > 0 && (
          <div class="nn-tags-group">
            {nnTags.map((tag) => (
              <a class="nn-tag" href={url_for(tag.path)} title={tag.name}>
                <span>{tag.name}</span>
                <sup>{tag.length}</sup>
              </a>
            ))}
          </div>
        )}
        {nnTags.length > 0 && (a.card_webinfo?.post_count || runtimeDays !== null) && <hr class="nn-divider" />}
        {(a.card_webinfo?.post_count || runtimeDays !== null) && (
          <div class="nn-analytics">
            {a.card_webinfo?.post_count && (
              <div class="nn-analytics-row"><span>文章数:</span><span>{posts.length}</span></div>
            )}
            {runtimeDays !== null && (
              <div class="nn-analytics-row"><span>建站天数:</span><span>{runtimeDays} 天</span></div>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</div>
