---
import ArticleListItem from "../../../../components/ArticleListItem.astro";
import Base from "../../../../layouts/Base.astro";
import Pagination from "../../../../components/Pagination.astro";
import { loadData, sortedPosts } from "../../../../lib/collections";
import { site } from "../../../../lib/site";

export async function getStaticPaths() {
  const data = await loadData();
  const perPage = site.index_per_page;
  const paths = [];
  const sorted = sortedPosts(data.posts);
  for (const c of data.categories) {
    const posts = sorted.filter((p) => p.categories.includes(c.name));
    const total = Math.max(1, Math.ceil(posts.length / perPage));
    for (let i = 2; i <= total; i++) {
      paths.push({
        params: { category: c.name, page: String(i) },
        props: { name: c.name, current: i, total, perPage },
      });
    }
  }
  return paths;
}

const { name, current, total, perPage } = Astro.props;
const data = await loadData();
const all = sortedPosts(data.posts).filter((p) => p.categories.includes(name));
const start = (current - 1) * perPage;
const posts = all.slice(start, start + perPage);
const base = `/categories/${encodeURIComponent(name)}/`;
---

<Base title={`分类: ${name}`} pageTitle={`分类: ${name}`} aside={false}>
  <div id="category-page" class="article-sort">
    <div class="article-sort-title">分类 - {name}</div>
    {posts.map((p) => (
      <ArticleListItem post={p} />
    ))}
    <Pagination current={current} total={total} base={base} />
  </div>
</Base>
