---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import CategoryBar from "../../components/CategoryBar.astro";
import { loadData, sortedPosts } from "../../lib/collections";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const data = await loadData();
  const posts = sortedPosts(data.posts);
  const perPage = (site as any).index_per_page || 10;
  const total = Math.max(1, Math.ceil(posts.length / perPage));
  const paths = [];
  // Page 1 is served by src/pages/index.astro; emit routes for page 2..N only.
  for (let i = 2; i <= total; i++) {
    paths.push({ params: { page: String(i) }, props: { current: i, total, perPage } });
  }
  return paths;
}

const { current, total, perPage } = Astro.props;
const data = await loadData();
const posts = sortedPosts(data.posts);
const start = (current - 1) * perPage;
const paged = posts.slice(start, start + perPage);
---

<Base title={site.title} isHome={true} pageTitle={site.title}>
  <div id="recent-posts" class="recent-posts">
    <CategoryBar />
    {paged.map((p, i) => <PostCard article={p} index={i} isHome={true} />)}
    <Pagination current={current} total={total} base="/" />
  </div>
</Base>
