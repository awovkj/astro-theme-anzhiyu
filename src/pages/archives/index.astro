---
import Base from "../../layouts/Base.astro";
import Pagination from "../../components/Pagination.astro";
import { loadData, sortedPosts, groupByYear } from "../../lib/collections";
import { site } from "../../lib/site";
import { url_for, date, date_xml, fullDate } from "../../lib/helpers";

const data = await loadData();
const posts = sortedPosts(data.posts);
const perPage = (site as any).index_per_page || 10;
const total = Math.max(1, Math.ceil(posts.length / perPage));
const paged = posts.slice(0, perPage);
const groups = groupByYear(paged);
const dateFmt = (site as any).date_format || "YYYY-MM-DD";
---

<Base title="归档" pageTitle="归档" aside={false}>
  <div class="article-sort-title">文章总览 - {posts.length}</div>
  <div id="archives" class="article-sort">
    {groups.map((g) => (
      <div class="article-sort-group">
        <div class="article-sort-item"><div class="article-sort-item-info"><div class="article-sort-item-time">{g.year}</div></div></div>
        {g.posts.map((p) => (
          <div class={`article-sort-item year-${g.year}`}>
            <a class="article-sort-item-img" href={url_for(p.path)}>
              {p.cover && <img src={url_for(String(p.cover))} alt={p.title} />}
            </a>
            <div class="article-sort-item-info">
              <div class="article-sort-item-time">
                <time datetime={date_xml(p.date)} title={fullDate(p.date)}>{date(p.date, dateFmt)}</time>
              </div>
              <a class="article-sort-item-title" href={url_for(p.path)} title={p.title}>{p.title}</a>
            </div>
          </div>
        ))}
      </div>
    ))}
    <Pagination current={1} total={total} base="/archives/" />
  </div>
</Base>
