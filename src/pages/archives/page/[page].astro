---
import ArticleListItem from "../../../components/ArticleListItem.astro";
import Base from "../../../layouts/Base.astro";
import Pagination from "../../../components/Pagination.astro";
import { loadData, chronologicalPosts, groupByYear } from "../../../lib/collections";
import { site } from "../../../lib/site";

export async function getStaticPaths() {
  const data = await loadData();
  const posts = chronologicalPosts(data.posts);
  const perPage = site.index_per_page;
  const total = Math.max(1, Math.ceil(posts.length / perPage));
  const paths = [];
  for (let i = 2; i <= total; i++) {
    paths.push({ params: { page: String(i) }, props: { current: i, total, perPage } });
  }
  return paths;
}

const { current, total, perPage } = Astro.props;
const data = await loadData();
const posts = chronologicalPosts(data.posts);
const start = (current - 1) * perPage;
const paged = posts.slice(start, start + perPage);
const groups = groupByYear(paged);
---

<Base title="归档" pageTitle="归档" aside={false}>
  <div class="article-sort-title">文章总览 - {posts.length}</div>
  <div id="archives" class="article-sort">
    {groups.map((g) => (
      <div class="article-sort-group">
        <div class="article-sort-item"><div class="article-sort-item-info"><div class="article-sort-item-time">{g.year}</div></div></div>
        {g.posts.map((p) => (
          <ArticleListItem post={p} year={g.year} />
        ))}
      </div>
    ))}
    <Pagination current={current} total={total} base="/archives/" />
  </div>
</Base>
