---
import ArticleListItem from "../../../components/ArticleListItem.astro";
import Base from "../../../layouts/Base.astro";
import { loadData, chronologicalPosts, type PostItem } from "../../../lib/collections";

export async function getStaticPaths() {
  const data = await loadData();
  const keys = new Set(data.posts.map((post: PostItem) => `${post.date.getFullYear()}-${String(post.date.getMonth() + 1).padStart(2, "0")}`));
  return [...keys].map((key: string) => {
    const [year, month] = key.split("-");
    return { params: { year, month }, props: { year: Number(year), month: Number(month) } };
  });
}

const { year, month } = Astro.props;
const data = await loadData();
const posts = chronologicalPosts(data.posts).filter(
  (post: PostItem) => post.date.getFullYear() === Number(year) && post.date.getMonth() + 1 === Number(month)
);
const archiveTitle = `归档 - ${year}年${month}月`;
---

<Base title={archiveTitle} pageTitle={archiveTitle} aside={false}>
  <div class="article-sort-title">{year} 年 {month} 月文章 - {posts.length}</div>
  <div id="archives" class="article-sort">
    {posts.length ? posts.map((p: PostItem) => (
      <ArticleListItem post={p} year={year} />
    )) : <p class="article-sort-empty">暂无文章</p>}
  </div>
</Base>
