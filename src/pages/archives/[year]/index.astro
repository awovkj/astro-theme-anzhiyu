---
import ArticleListItem from "../../../components/ArticleListItem.astro";
import Base from "../../../layouts/Base.astro";
import { loadData, chronologicalPosts } from "../../../lib/collections";

export async function getStaticPaths() {
  const data = await loadData();
  const years = [...new Set(data.posts.map((post) => post.date.getFullYear()))];
  return years.map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props;
const data = await loadData();
const posts = chronologicalPosts(data.posts).filter((post) => post.date.getFullYear() === Number(year));
const archiveTitle = `归档 - ${year}`;
---

<Base title={archiveTitle} pageTitle={archiveTitle} aside={false}>
  <div class="article-sort-title">{year} 年文章 - {posts.length}</div>
  <div id="archives" class="article-sort">
    {posts.length ? posts.map((p) => (
      <ArticleListItem post={p} year={year} />
    )) : <p class="article-sort-empty">暂无文章</p>}
  </div>
</Base>
