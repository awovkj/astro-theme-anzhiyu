---
import Base from "../layouts/Base.astro";
import { getLinkList, type LinkGroup, type LinkItem } from "../lib/pageData";
import { url_for } from "../lib/helpers";
import { theme } from "../lib/theme";
import { _p } from "../lib/i18n";

const groups = getLinkList();
const t = theme as any;
const flinkErr = url_for(t.error_img?.flink || "/img/friend_404.gif");
const postPageErr = url_for(t.error_img?.post_page || "/img/404.jpg");
const linkPageTop = t.linkPageTop || {};
const friendsVue = t.friends_vue || {};

function avatarWithoutBang(url: string): string {
  const i = url.indexOf("!");
  return i !== -1 ? url.substring(0, i) : url;
}

interface BannerPair {
  even: { link: string; name: string; avatar: string };
  odd: { link: string; name: string; avatar: string };
}
function buildBannerPairs(list: LinkGroup[]): BannerPair[] {
  const pairs: BannerPair[] = [];
  for (let pass = 0; pass < 2; pass++) {
    for (const g of list.slice(0, 15)) {
      const ll = g.link_list.slice();
      const hundredSuffix = g.hundredSuffix || "";
      const evenNum = ll.filter((_, i) => i % 2 === 0);
      const oddNum = ll.filter((_, i) => i % 2 === 1);
      const count = Math.min(evenNum.length, oddNum.length);
      for (let index2 = 0; index2 < count; index2++) {
        const index = index2 * 2;
        if (index <= 15 && evenNum[index] && oddNum[index]) {
          pairs.push({
            even: { link: evenNum[index].link, name: evenNum[index].name, avatar: avatarWithoutBang(evenNum[index].avatar) + hundredSuffix },
            odd: { link: oddNum[index].link, name: oddNum[index].name, avatar: avatarWithoutBang(oddNum[index].avatar) + hundredSuffix },
          });
        }
      }
    }
  }
  return pairs;
}

const bannerPairs = linkPageTop.enable ? buildBannerPairs(groups) : [];
const onerrFlink = `this.onerror=null;this.src='${flinkErr}'`;
const onerrPost = `this.onerror=null;this.src='${postPageErr}'`;

---

<Base title="友情链接" pageTitle="友情链接" topImg={false} aside={false}>
  <div id="page">
    <div id="article-container">
      {linkPageTop.enable && (
        <div id="flink-banners">
          <div class="banner-top-box">
            <div class="flink-banners-title">
              <div class="banners-title-small">{_p("flink.title")}</div>
              <div class="banners-title-big">{linkPageTop.title || _p("flink.title")}</div>
            </div>
            <div class="banner-button-group">
              {friendsVue.apiurl && (
                <a class="banner-button secondary no-text-decoration" onclick="friendChainRandomTransmission()">
                  <i class="anzhiyufont anzhiyu-icon-paper-plane1"></i>
                  <span class="banner-button-text">{_p("flink.random_visit")}</span>
                </a>
              )}
            </div>
          </div>
          <div id="skills-tags-group-all">
            <div class="tags-group-wrapper">
              {bannerPairs.map((p) => (
                <div class="tags-group-icon-pair">
                  <a class="tags-group-icon no-text-decoration" href={url_for(p.even.link)} title={p.even.name}>
                    <img class="no-lightbox" title={p.even.name} src={url_for(p.even.avatar)} onerror={onerrFlink} alt={p.even.name} />
                  </a>
                  <a class="tags-group-icon no-text-decoration" href={url_for(p.odd.link)} title={p.odd.name}>
                    <img class="no-lightbox" title={p.odd.name} src={url_for(p.odd.avatar)} onerror={onerrFlink} alt={p.odd.name} />
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {friendsVue.enable && (
        <div class="title-h2-a">
          <div class="title-h2-a-left">
            <h2 style="padding-top:0;margin:.6rem 0 .6rem">{_p("flink.fishing")}</h2>
            <a class="random-post-start no-text-decoration" href="javascript:fetchRandomPost();">
              <i class="anzhiyufont anzhiyu-icon-arrow-rotate-right"></i>
            </a>
          </div>
          <div class="title-h2-a-right">
            <a class="random-post-all no-text-decoration" href={url_for("link/")}>{_p("flink.all_links")}</a>
          </div>
        </div>
      )}
      {friendsVue.enable && <div id="random-post"></div>}

      <div class="flink">
        {groups.map((g: LinkGroup) => {
          const style = g.flink_style || "anzhiyu";
          return (
            <>
              {g.class_name && <h2 set:html={`${g.class_name}(${g.link_list.length})`} />}
              {g.class_desc && <div class="flink-desc" set:html={g.class_desc} />}

              {style === "anzhiyu" && (
                <div class={g.lost_contact ? "anzhiyu-flink-list cf-friends-lost-contact" : "anzhiyu-flink-list"}>
                  {g.link_list.map((item: LinkItem) => {
                    const color = item.color || "";
                    const tag = item.tag || "";
                    return (
                      <div class="flink-list-item">
                        {color === "vip" && tag && (
                          <span class="site-card-tag vip">{tag}<i class="light"></i></span>
                        )}
                        {color !== "vip" && color === "speed" && tag && (
                          <span class="site-card-tag speed">{tag}</span>
                        )}
                        {color !== "vip" && color !== "speed" && tag && (
                          <span class="site-card-tag" style={`background-color: ${color}`}>{tag}</span>
                        )}
                        {color !== "vip" && color !== "speed" && !tag && item.recommend && (
                          <span class="site-card-tag">{_p("flink.recommend")}</span>
                        )}
                        {g.lost_contact ? (
                          <a class="cf-friends-link" href={url_for(item.link)} title={item.name} target="_blank">
                            <img class="cf-friends-avatar no-lightbox" src={url_for(item.avatar)} onerror={onerrFlink} alt={item.name} />
                            <div class="flink-item-info">
                              <div class="flink-item-name cf-friends-name-lost-contact">{item.name}</div>
                            </div>
                          </a>
                        ) : (
                          <a class="cf-friends-link" href={url_for(item.link)} cf-href={url_for(item.link)} title={item.name} target="_blank">
                            <img class="cf-friends-avatar no-lightbox" src={url_for(item.avatar)} onerror={onerrFlink} alt={item.name} />
                            <div class="flink-item-info">
                              <div class="flink-item-name cf-friends-name">{item.name}</div>
                              <div class="flink-item-desc" title={item.descr}>{item.descr}</div>
                            </div>
                          </a>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}

              {style === "telescopic" && (
                <div class="telescopic-site-card-group">
                  {g.link_list.map((item: LinkItem) => {
                    const color = item.color || "";
                    const tag = item.tag || "";
                    const siteshot = item.siteshot || `https://image.thum.io/get/width/400/crop/800/allowJPG/wait/20/noanimate/${item.link}`;
                    return (
                      <div class="site-card">
                        {color === "vip" && tag && <span class="site-card-tag vip">{tag}<i class="light"></i></span>}
                        {color !== "vip" && color === "speed" && tag && <span class="site-card-tag speed">{tag}</span>}
                        {color !== "vip" && color !== "speed" && tag && <span class="site-card-tag" style={`background-color: ${color}`}>{tag}</span>}
                        {color !== "vip" && color !== "speed" && !tag && item.recommend && <span class="site-card-tag">{_p("flink.recommend")}</span>}
                        <a class="img no-text-decoration" target="_blank" title={item.name} href={item.link} rel="external nofollow">
                          <img class="flink-avatar" src={siteshot} onerror={`this.onerror=null;this.src='${flinkErr}'`} alt={item.name} style="pointer-events: none;" />
                        </a>
                        <a class="info cf-friends-link no-text-decoration" target="_blank" title={item.name} href={item.link} cf-href={url_for(item.link)} rel="external nofollow">
                          <div class="site-card-avatar">
                            <img class="flink-avatar cf-friends-avatar no-fancybox" src={item.avatar} onerror={`this.onerror=null;this.src='${flinkErr}'`} alt={item.name} />
                          </div>
                          <div class="site-card-text">
                            <span class="title cf-friends-name">{item.name}</span>
                            <span class="desc" title={item.descr}>{item.descr}</span>
                          </div>
                        </a>
                      </div>
                    );
                  })}
                </div>
              )}

              {style === "flexcard" && (
                <div class="flexcard-flink-list">
                  {g.link_list.map((item: LinkItem) => {
                    const siteshot = item.siteshot ? url_for(item.siteshot) : `https://image.thum.io/get/width/400/crop/800/allowJPG/wait/20/noanimate/${item.link}`;
                    return (
                      <a class="flink-list-card cf-friends-link" href={url_for(item.link)} cf-href={url_for(item.link)} target="_blank" data-title={item.descr}>
                        <div class="wrapper cover">
                          <img class="cover fadeIn" src={siteshot} onerror={onerrPost} alt="cover" />
                        </div>
                        <div class="info">
                          <img class="cf-friends-avatar no-lightbox" src={url_for(item.avatar)} onerror={onerrFlink} alt="cover" />
                          <span class="flink-sitename cf-friends-name">{item.name}</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </>
          );
        })}
      </div>
    </div>
  </div>
</Base>
