---
import ArticleListItem from "../../components/ArticleListItem.astro";
import Base from "../../layouts/Base.astro";
import Pagination from "../../components/Pagination.astro";
import { loadData, sortedPosts } from "../../lib/collections";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const data = await loadData();
  return data.tags.map((tag) => ({ params: { tag: tag.name }, props: { name: tag.name } }));
}

const { name } = Astro.props;
const data = await loadData();
const all = sortedPosts(data.posts).filter((p) => p.tags.includes(name));
const perPage = site.index_per_page;
const total = Math.max(1, Math.ceil(all.length / perPage));
const posts = all.slice(0, perPage);
const base = `/tags/${encodeURIComponent(name)}/`;
---

<Base title={`标签: ${name}`} pageTitle={`标签: ${name}`} aside={false}>
  <div id="tag-page" class="article-sort">
    <div class="article-sort-title">标签 - {name}</div>
    {posts.map((p) => (
      <ArticleListItem post={p} />
    ))}
    <Pagination current={1} total={total} base={base} />
  </div>
</Base>
