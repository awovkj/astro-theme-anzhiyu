---
import "../styles/theme.css";
import "../styles/custom.css";
import "../styles/font-extra.css";
import { theme } from "../lib/theme";
import { site } from "../lib/site";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import Aside from "../components/Aside.astro";
import Music from "../components/Music.astro";
import Loading from "../components/Loading.astro";
import Popup from "../components/Popup.astro";
import LocalSearch from "../components/LocalSearch.astro";
import TopHome from "../components/TopHome.astro";
import { loadData, sortedPosts } from "../lib/collections";
import type { PostItem } from "../lib/collections";

interface Props {
  title: string;
  pageTitle?: string;
  keywords?: string;
  description?: string;
  isPost?: boolean;
  isHome?: boolean;
  is404?: boolean;
  topImg?: string | false;
  subtitle?: string;
  showToc?: boolean;
  tocHtml?: string;
  aside?: boolean;
  post?: PostItem;
  content?: string;
  postUpdate?: string;
}
const {
  title,
  pageTitle,
  keywords,
  description,
  isPost = false,
  isHome = false,
  is404 = false,
  topImg,
  subtitle = site.subtitle,
  showToc = false,
  tocHtml = "",
  aside,
  post,
  content = "",
  postUpdate = "",
} = Astro.props;

const t = theme as any;
const data = await loadData();
const posts = sortedPosts(data.posts);
const searchEnabled = !!(t.local_search && t.local_search.enable);
const asideEnabled = !is404 && !!t.aside?.enable && aside !== false;
const hideAside = aside === false || !t.aside?.enable ? "hide-aside" : "";
const htmlHideAside = t.aside?.enable && t.aside?.hide ? "hide-aside" : "";
const pageType = isPost ? "post" : "page";

// top image resolution (mirrors layout.pug)
let resolvedTopImg: string | false = topImg !== undefined ? topImg : false;
if (topImg === undefined) {
  if (isPost && post) resolvedTopImg = typeof post.cover === "string" ? post.cover : false;
  else if (isHome) resolvedTopImg = t.index_img !== false ? t.index_img || t.default_top_img || false : false;
  else if (!is404) resolvedTopImg = t.default_top_img || false;
  else resolvedTopImg = false;
}
const disableTopImg = t.disable_top_img;
if (disableTopImg) resolvedTopImg = false;
---

<!doctype html>
<html lang={site.language} data-theme={t.display_mode} class={htmlHideAside}>
  <head>
    <Head title={title} pageTitle={pageTitle} keywords={keywords} description={description} isPost={isPost} isHome={isHome} showToc={showToc} postUpdate={postUpdate} />
  </head>
  <body data-type="anzhiyu">
    <div id="web_bg"></div>
    <div id="an_music_bg"></div>

    {t.preloader?.enable && <Loading />}

    {is404 ? (
      <slot />
    ) : (
      <div id="body-wrap" class={pageType}>
        <Header isHome={isHome} isPost={isPost} title={pageTitle || title} topImg={resolvedTopImg} subtitle={subtitle} post={post} content={content} />
        <main id="blog-container">
          {isHome && <TopHome posts={posts} tags={data.tags} />}
          <div id="content-inner" class={`layout ${hideAside}`}>
            <slot />
            {asideEnabled && <Aside isPost={isPost} showToc={showToc} tocHtml={tocHtml} posts={posts} tags={data.tags} />}
          </div>
        </main>
        <footer id="footer">
          <Footer />
        </footer>
      </div>
    )}

    <Sidebar postsCount={posts.length} tagsCount={data.tags.length} categoriesCount={data.categories.length} tags={data.tags} />
    <Music />
    <Popup />
    {searchEnabled && <LocalSearch />}

    <script>
      import "../scripts/theme.ts";
    </script>
  </body>
</html>
